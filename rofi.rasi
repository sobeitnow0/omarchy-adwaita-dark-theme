/* ─────────────────────────────────────────────────────────────
   Adwaita Dark — Rofi Application Launcher Theme
   GNOME 50 Libadwaita launcher aesthetic
   ───────────────────────────────────────────────────────────── */

* {
    font: "Adwaita 12";
    background-color: transparent;
    text-color: #ffffff;
}

window {
    background-color: #242424;
    border: 1px;
    border-color: #3584e4;
    border-radius: 14px;
    width: 600px;
    padding: 16px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    background-color: #1d1d1d;
    border-radius: 10px;
    padding: 10px 14px;
    children: [ prompt, entry ];
    spacing: 10px;
}

prompt {
    text-color: #3584e4;
    font: "Adwaita Bold 12";
}

entry {
    placeholder: "Search apps...";
    placeholder-color: #5c6370;
    text-color: #ffffff;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    spacing: 4px;
}

element {
    padding: 8px 12px;
    border-radius: 8px;
    children: [ element-icon, element-text ];
    spacing: 10px;
}

element selected {
    background-color: #3584e4;
    text-color: #ffffff;
}

element-text {
    vertical-align: 0.5;
}

element-icon {
    size: 24px;
}
